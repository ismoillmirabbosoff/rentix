# =============================================================================
# Rentix deployment sozlamalari
#
#   cp .env.example .env    va quyidagilarni to'ldiring.
#   ./deploy.sh install     SECRET_KEY va POSTGRES_PASSWORD ni avtomatik yaratadi.
#
# DIQQAT: .env faylini hech qachon git'ga qo'shmang.
# =============================================================================

# ─────────────────────────────────────────────────────────────────── DOMENLAR
# Bu domenlarning A-record'i shu serverning IP manziliga qaratilgan bo'lishi shart.
USER_DOMAIN=user.rentix.uz
ADMIN_DOMAIN=admin.rentix.uz
API_DOMAIN=api.rentix.uz

# Let's Encrypt sertifikat muddati tugashi haqida xabar keladigan pochta
ACME_EMAIL=admin@rentix.uz

# ────────────────────────────────────────────────────────────────────── DJANGO
# MAJBURIY va MAXFIY. ./deploy.sh install avtomatik yaratadi.
# Qo'lda:  python3 -c "import secrets;print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=False
ALLOWED_HOSTS=api.rentix.uz,user.rentix.uz,admin.rentix.uz,rentix-backend,localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=https://user.rentix.uz,https://admin.rentix.uz
CSRF_TRUSTED_ORIGINS=https://user.rentix.uz,https://admin.rentix.uz,https://api.rentix.uz

# TLS Caddy da tugatiladi -> cookie lar faqat HTTPS orqali
SECURE_SSL=True
# HTTP->HTTPS redirectni Caddy bajaradi, Django takrorlamasin
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000

LOG_LEVEL=INFO

# ──────────────────────────────────────────────────────────────────── POSTGRES
POSTGRES_DB=rentixdb
POSTGRES_USER=rentixuser
# MAJBURIY va MAXFIY. ./deploy.sh install avtomatik yaratadi.
POSTGRES_PASSWORD=

# Ulanishni necha sekund tirik saqlash (0 — har so'rovda yangidan ulanadi)
DB_CONN_MAX_AGE=60
# gunicorn worker soni. Tavsiya: (CPU yadrolari x 2) + 1
WEB_CONCURRENCY=4

# ───────────────────────────────────────────────────────────────────────── SMS
# stage — PRODUKSHN: SMSFly orqali haqiqiy SMS yuboriladi
# dev   — SMS YUBORILMAYDI, tasdiqlash kodi API javobida ochiq qaytadi.
#         Prodda ishlatmang: istalgan odam istalgan raqam nomidan kiradi.
SMS_MODE=stage
# MAJBURIY (stage rejimida). Tekshirish:
#   docker compose exec backend python manage.py sms_check_key
#   -> success=True reason=KEY_IS_CORRECT bo'lishi kerak
SMSFLY_API_KEY=
# Faqat dev rejimi uchun
SMS_DEV_CODE=1111

# ───────────────────────────────────────────────────────────────────── TELEGRAM
# Mini-app ochiladigan manzil va webhook uchun backend manzili
RENTIX_USER_WEBAPP_URL=https://user.rentix.uz
RENTIX_BACKEND_PUBLIC_URL=https://api.rentix.uz
TELEGRAM_BOT_MENU_TEXT=Rentix
TELEGRAM_API_TIMEOUT=10
# PRODDA HAR DOIM False. True bo'lsa istalgan odam istalgan Telegram
# hisobi nomidan tizimga kira oladi.
TELEGRAM_ALLOW_MOCK_INITDATA=False
# Global bot tokeni (har bir kompaniya o'z tokenini admin paneldan kiritadi)
TELEGRAM_BOT_TOKEN=

# ───────────────────────────────────────────────────────────── FAYL SAQLASH (S3)
# Bo'sh qoldirilsa fayllar server diskiga (docker volume) saqlanadi va
# frontend nginx orqali /media/ manzilida beriladi. S3/Spaces kerak bo'lsa
# to'rttasini ham to'ldiring.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=sgp1
AWS_S3_CUSTOM_DOMAIN=
AWS_DEFAULT_ACL=

# ──────────────────────────────────────────────────────────── GOOGLE OAUTH (ixtiyoriy)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ─────────────────────────────────────────────────── TO'LOV TIZIMLARI (ixtiyoriy)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER=

PAYME_ID=
PAYME_KEY=
PAYME_MIN_AMOUNT=
PAYME_ACCOUNT=
PAYME_TOKEN=

KASSA_ID=
PAYCOM_ID=
PAYCOM_KEY=
